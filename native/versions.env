# Pinned native sources for jLimeSDR releases. Sourced by the build scripts and
# read by the GitHub workflows. To move to a newer upstream commit, change these
# values and open a pull request.
#
# LIMESUITENG_REF is the upstream tag or full commit to build. It is a commit on
# develop: the v25.1.0 tag and the stable branch predate many fixes to the
# legacy LMS_* API that jLimeSDR binds, and Windows ARM64 support.
# LIMESUITENG_VERSION must equal the project version that the top-level
# CMakeLists.txt names at that ref, which the build checks. It is also the
# jLimeSDR version.
LIMESUITENG_REPOSITORY=https://github.com/myriadrf/LimeSuiteNG.git
LIMESUITENG_REF=6c3feee9006b8ed8aad951ca377c9c72406ab420
LIMESUITENG_VERSION=25.1.0
LIBUSB_VERSION=1.0.30
LIBUSB_TARBALL_SHA256=fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf
# Windows only: the Cypress FX3 SDK that LimeSuiteNG downloads for LimeSDR-USB
# support. It has x64 libraries only, so windows-aarch64 is built without it.
FX3SDK_URL=https://downloads.myriadrf.org/project/limesuite/appveyor/FX3SDK.zip
FX3SDK_SHA1=f24fd11fcac1099312fe6fb534145169dc35a75a
